# =============================================================================
# OnBoardIQ Backend — Environment Configuration Template
# =============================================================================
# Copy this file to .env for local development or populate values in Render Dashboard.

# Application Settings
APP_NAME="OnBoardIQ"
ENVIRONMENT="development"  # Options: 'development' | 'production'
PORT=8000

# Database Configuration
# Local Development (SQLite):
DATABASE_URL="sqlite:///./skillsprint.db"
# Production (Render PostgreSQL):
# DATABASE_URL="postgresql://username:password@hostname:5432/dbname"

# Database Connection Pooling (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# CORS Configuration (Comma-separated list of allowed origins)
# For production, set to your Vercel URL (e.g., https://onboardiq.vercel.app)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"

# Google Gemini API (Pipeline 1 Plan Generation)
# Required on Render Backend ONLY — NEVER expose to Next.js or client-side code
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GENAI_MODEL="gemini-2.5-flash"

# Document Storage Settings
# In local development: ./uploads
# On Render with Persistent Disk: /data/uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=26214400  # 25 MB max limit
